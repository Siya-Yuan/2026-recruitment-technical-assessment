#base image
FROM node:24.10-alpine AS build

#change directories to execute commands
WORKDIR /app


#copy files into the container in app
COPY package.json /app/

#copy everything else 
#COPY . .

#reading, download dependencies inside the container before application starts 
RUN npm install

#optmising layer caching
COPY . . 

#build dist folder
RUN npm run build

#trying out multi stage build
FROM node:24.10-alpine

COPY --from=build /app /app

EXPOSE 3000

#Starts application
CMD ["node", "dist/server.js"]